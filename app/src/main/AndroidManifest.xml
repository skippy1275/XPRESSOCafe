<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.xpressocafe">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.XPRESSOCafe"
        android:usesCleartextTraffic="true">

        <activity
            android:name="com.example.xpressocafe.OrderHistoryActivity"
            android:exported="false"
            android:label="@string/title_order_history" />

        <activity
            android:name="com.example.xpressocafe.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings" />

        <activity
            android:name="com.example.xpressocafe.MainActivity"
            android:exported="false"
            android:label="@string/title_menu" />

        <activity
            android:name="com.example.xpressocafe.RegisterActivity"
            android:exported="false"
            android:label="@string/register_title" />

        <activity
            android:name="com.example.xpressocafe.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
